// ============================================
// ANALYTICS — first-party behavioural events
// ============================================
// Lightweight append-only event log powering the admin analytics dashboard.
// IDs (listingId/buildingId/unitId) are intentionally loose references (no FK)
// so events survive entity deletion and inserts stay cheap. No PII beyond an
// anonymous client session id + user agent.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String   // page_view | listing_view | listing_click | inquiry_click | phone_click | whatsapp_click | search | favorite
  path       String?
  listingId  String?
  buildingId String?
  unitId     String?
  sessionId  String?  // anonymous visitor session (client-generated uuid)
  userId     String?  // set when the visitor is authenticated
  referrer   String?
  userAgent  String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([listingId])
  @@index([sessionId])
  @@map("analytics_events")
}

// ============================================
// OWNER SUBMISSIONS — zero-commission campaign
// ============================================
// A property owner fills the public "list your property" form; an admin reviews
// it, contacts the seller, and on approval a Building (source=OWNER) + Unit +
// Listing are created from it. Intentionally denormalized — it's an intake
// record, not the live property.
model PropertySubmission {
  id     String           @id @default(cuid())
  status SubmissionStatus @default(PENDING)

  // Seller contact — how we reach them
  sellerName       String
  sellerPhone      String
  sellerEmail      String?
  preferredContact String? // phone | whatsapp | email

  // What they're listing
  title        String
  description  String?
  extraDetails String?       // optional free-text: extra notes the seller wants to add
  locationUrl  String?       // optional Google Maps link the seller pastes
  unitKind     UnitKind      @default(APARTMENT)
  intent       ListingIntent @default(FOR_SALE)
  bedrooms     Int?
  bathrooms    Int?
  areaSqm      Float?
  floor        Int?
  price        Float?
  currency     String        @default("USD")
  negotiable   Boolean       @default(false)

  // Location (same Lebanon hierarchy as Building)
  mohafazat    String?
  caza         String?
  city         String?
  neighborhood String?
  address      String?

  // Media uploaded by the seller (proxied R2 URLs)
  images String[]
  videos String[]
  // Seller has no photos and wants our team to visit and shoot them for free.
  wantsPhotoVisit Boolean @default(false)

  // Internal follow-up steps before the property goes on the website
  visited       Boolean @default(false) // our team visited the property
  dataCollected Boolean @default(false) // full details/paperwork gathered

  // Review trail
  adminNotes   String?   // internal — never shown to the seller
  reviewedById String?
  reviewedAt   DateTime?
  buildingId   String?   @unique // set when approved → the created property

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("property_submissions")
}

// ============================================
// CRM — buyer/seller leads and follow-up
// ============================================
// Replaces the follow-up spreadsheet: who wants what, where, how much, when we
// last spoke and when to call next. Shared across both PropGroup markets
// (Lebanon listings here, Georgia investment sales on propgrp.com) so the team
// works one pipeline. Leads can be entered by hand or captured automatically
// from an inquiry / favourite / owner submission.

enum LeadType {
  BUYER
  SELLER
  RENTER
  LANDLORD
  INVESTOR
}

enum LeadStatus {
  NEW         // just captured, nobody worked it yet
  ACTIVE      // in conversation / actively searching
  VIEWING     // scheduled or completed viewings
  NEGOTIATING // offer on the table
  WON         // closed a deal
  LOST        // went elsewhere / not interested
  ARCHIVED    // parked, no longer followed up
}

// Why an active client is still active. LeadStatus says where they are in the
// pipeline; this says what is actually holding them there, so a card sitting in
// Active for three weeks explains itself.
enum LeadSubStatus {
  SEARCHING       // we're actively sending them options
  AWAITING_REPLY  // ball is in their court
  NEEDS_OPTIONS   // everything shown is ruled out — we owe them fresh stock
  BUDGET_MISMATCH // what they want costs more than they'll pay
  FINANCING       // arranging a loan / selling something first
  PAUSED          // asked us to pause (travel, ramadan, waiting on a sale)
  DOCS_PENDING    // seller side: waiting on papers, deed, authorisation
  PRICE_REVIEW    // seller side: asking price needs revisiting
}

enum LeadSource {
  MANUAL      // typed in by the team
  INQUIRY     // property inquiry form
  FAVORITE    // saved a property while logged in
  SUBMISSION  // came through list-your-property
  REFERRAL
  WHATSAPP
  PHONE
  WALK_IN
  FACEBOOK_AD // auto-created from a Lead Ads webhook
}

// Which side of the business the lead belongs to.
enum LeadMarket {
  LEBANON // propgrouplb.com — local sale/rent
  GEORGIA // propgrp.com — Batumi/Tbilisi investment
}

enum ContactChannel {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  VIEWING
  NOTE
}

model Lead {
  id     String     @id @default(cuid())
  market LeadMarket @default(LEBANON)
  type   LeadType   @default(BUYER)
  status LeadStatus @default(ACTIVE)
  source LeadSource @default(MANUAL)

  // Nullable = derive it from the pipeline; set = the team overrode it.
  subStatus LeadSubStatus?

  // Who
  name     String
  phone    String?
  email    String?
  whatsapp String?

  // What they're asking for — free text mirrors the old sheet's "Asking for",
  // the structured fields power matching against live listings.
  askingFor String? // e.g. "Land", "Apartment", "Studio for investment"
  unitKinds UnitKind[]
  // Locations are picked from the curated per-market catalogue (never free text).
  // A client may name specific areas, or only regions when they're open to a
  // whole region, or both.
  areas   String[] // ["Achrafieh", "Bouchrieh", "Zalka"]
  regions String[] // Lebanese mohafazat values, or GE_* for Georgia
  minBeds Int?
  budgetMin Float?
  budgetMax Float?
  currency  Currency @default(USD)

  lastContactAt       DateTime?
  contactIntervalDays Int       @default(7)
  // An appointment the team deliberately made ("call him Monday"). Never
  // derived from a cadence — an inbox full of invented overdue dates is noise,
  // and the team stops trusting the red badges.
  nextContactAt       DateTime?
  // What the planned contact is for, shown next to the date.
  nextContactNote     String?

  notes String?

  // When the relationship reached a terminal state (WON/LOST). Lets the board
  // show only recent wins instead of accumulating closed deals forever.
  closedAt DateTime?

  // Optional links back into the platform
  userId    String? // registered user this lead corresponds to
  listingId String? // a specific listing they asked about

  // External identities, so an inbound WhatsApp message or Lead Ads submission
  // lands on the existing client instead of creating a duplicate.
  waId           String? @unique // WhatsApp phone-number id (digits, E.164 without +)
  externalLeadId String? @unique // Facebook leadgen id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // admin who added the lead

  contacts      LeadContact[]
  opportunities LeadOpportunity[] @relation("LeadOpportunities")
  properties    LeadProperty[]    @relation("LeadProperties")

  @@index([market])
  @@index([status])
  @@index([type])
  @@index([nextContactAt])
  @@index([subStatus])
  @@index([userId])
  @@index([createdAt])
  @@map("leads")
}

model LeadContact {
  id      String         @id @default(cuid())
  leadId  String
  channel ContactChannel @default(CALL)
  body    String
  outcome String?

  contactedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  createdBy   String? // admin who logged it

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([contactedAt])
  @@map("lead_contacts")
}

// ── Opportunities ─────────────────────────────────────────────────────────────
// A client's interest in ONE specific property (or in one counterpart client).
//
// Why this exists: a viewing that goes badly doesn't end the relationship — it
// rules out that property and sends the client back to searching. Tracking the
// stage on the Lead alone loses that: you can't tell what was shown, why it was
// rejected, or stop the matcher re-suggesting the same apartment. A client can
// also be viewing one property while negotiating another, which a single status
// can't express. So the deal lives here, and Lead.status describes the
// relationship.

enum OpportunityStage {
  SUGGESTED      // matched by the system, not shown to the client yet
  SHARED         // sent to the client (WhatsApp/email)
  VIEWING_BOOKED // viewing scheduled
  VIEWED         // viewing happened — awaiting or has feedback
  INTERESTED     // liked it, wants to proceed
  OFFER_MADE     // offer submitted
  WON            // deal closed on this property
  REJECTED       // ruled out — never suggest again
}

// Why a client ruled a property out. Drives smarter future matching.
enum RejectionReason {
  PRICE_TOO_HIGH
  TOO_SMALL
  TOO_BIG
  LOCATION
  CONDITION
  LAYOUT
  FLOOR_LEVEL
  NO_PARKING
  NOISE
  NO_VIEW
  NO_ELEVATOR
  BUILDING_QUALITY
  CHANGED_MIND
  BOUGHT_ELSEWHERE
  UNAVAILABLE   // sold/rented to someone else
  OTHER
}

// Provenance for rows brought in from the Georgia system.
//
// Doing three jobs at once: it makes the import idempotent (a second run skips
// what it already created), reversible (delete every target in a batch and the
// database is back where it started), and auditable (which propgrp.com row did
// this building come from). Kept out of the domain models so Building/Unit
// stay clean.
model ImportedRecord {
  id String @id @default(cuid())

  batch        String // "georgia-2026-08-05"
  sourceSystem String // "propgrp"
  sourceTable  String // "properties"
  sourceId     String
  targetTable  String // "buildings"
  targetId     String

  createdAt DateTime @default(now())

  @@unique([sourceSystem, sourceTable, sourceId, targetTable])
  @@index([batch])
  @@map("imported_records")
}

// An inbound WhatsApp message from a number we don't recognise.
//
// Auto-creating a client from every inbound message is how a CRM becomes
// unusable: a work number receives suppliers, family, wrong numbers and spam
// alongside real enquiries. Unknown senders land here instead, and only become
// clients when a person says so. Messages from numbers we already know skip
// this entirely and go straight onto that client's timeline.
model InboundMessage {
  id      String @id @default(cuid())
  channel InboundChannel @default(WHATSAPP)

  // Sender identity as the platform reports it.
  waId        String
  profileName String?
  body        String

  status InboundStatus @default(PENDING)

  // Set once triaged into the CRM, so the thread can be followed.
  leadId String?

  receivedAt DateTime @default(now())
  handledAt  DateTime?
  handledBy  String?

  @@index([status, receivedAt])
  @@index([waId])
  @@map("inbound_messages")
}

enum InboundChannel {
  WHATSAPP
}

enum InboundStatus {
  PENDING   // waiting for someone to look at it
  ADDED     // became a client
  IGNORED   // not business — dismissed
  BLOCKED   // never ask about this number again
}

// Numbers whose messages we never want to see again — suppliers, spam, the
// landlord of the office. Kept separately from the messages so the block
// survives clearing the inbox.
model BlockedSender {
  id        String   @id @default(cuid())
  waId      String   @unique
  label     String?
  createdAt DateTime @default(now())

  @@map("blocked_senders")
}

// An investment opportunity we resell — currently Georgia stock listed on
// propgrp.com.
//
// Lebanese buyers get matched against live listings on this site. Georgia
// investors had nothing to be matched against at all, because that inventory
// lives on another domain, so the CRM could store their phone number and
// nothing else. This is the minimum mirror of that stock needed to answer
// "what can I offer this client" without leaving the CRM.
model InvestmentProduct {
  id     String     @id @default(cuid())
  market LeadMarket @default(GEORGIA)

  name      String  // "Orbi City Batumi"
  developer String?
  city      String? // Batumi, Tbilisi
  region    String? // GE_* region key, matching Lead.regions

  unitKinds UnitKind[]
  priceFrom Float?
  priceTo   Float?
  currency  Currency @default(USD)

  // What makes it an *investment* rather than a home — the questions a Georgia
  // buyer actually asks first.
  expectedYield Float?    // annual rental yield, %
  handoverAt    DateTime? // off-plan completion
  paymentPlan   String?   // "30% down, 24 months interest free"

  // Where the client can see it — the propgrp.com listing.
  url    String?
  images String[]

  notes  String?
  status InvestmentProductStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([market])
  @@index([status])
  @@map("investment_products")
}

enum InvestmentProductStatus {
  AVAILABLE
  LIMITED   // nearly sold out — worth telling the client
  SOLD_OUT
  PAUSED
}

// A property a seller/landlord client has on the market.
//
// A seller's own fields (areas, budget, unitKinds) describe *one* thing, which
// stops working the moment he lists a second — and most do. Each row here is a
// separate saleable asset that buyers get matched against independently.
model LeadProperty {
  id     String @id @default(cuid())
  leadId String

  kind        UnitKind @default(APARTMENT)
  title       String?  // "3BR Achrafieh, 5th floor, sea view"
  areas       String[] // curated area names, same catalogue as Lead.areas
  region      String?
  askingPrice Float?
  currency    Currency @default(USD)
  bedrooms    Int?
  areaSqm     Float?

  status LeadPropertyStatus @default(AVAILABLE)

  // Where it lives, if anywhere: a listing on this site, or a link to the
  // Georgia site / an external portal for stock we don't host.
  listingId   String?
  externalUrl String?

  notes String?

  // Filled in when it sells. Commission is what we actually earned, in USD, so
  // the total is meaningful across a book quoted in mixed currencies.
  soldPrice     Float?
  commissionUsd Float?
  soldAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation("LeadProperties", fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status])
  @@map("lead_properties")
}

enum LeadPropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
  WITHDRAWN
}

model LeadOpportunity {
  id     String           @id @default(cuid())
  leadId String
  stage  OpportunityStage @default(SUGGESTED)

  // What's on offer — exactly one of these identifies it:
  listingId         String? // a live listing on our site
  counterpartLeadId String? // another client (a seller/landlord in the CRM)
  leadPropertyId    String? // a specific property a seller client has on offer
  productId         String? // a Georgia investment opportunity we resell

  // Off-platform stock: a Batumi studio on propgrp.com, another agency's
  // listing, a private sale. Clients buy these too, and a CRM that can't
  // record the deal can't tell you what you earned.
  externalTitle String?
  externalUrl   String?

  // Match score (0-100) when the pairing was created - for later review.
  matchScore Int?

  // Viewing + outcome
  viewingAt       DateTime?
  viewedAt        DateTime?
  rejectionReason RejectionReason?
  feedback        String? // what the client actually said

  // The money, recorded once on the opportunity that actually closed.
  // commissionUsd is normalised to USD so totals mean something.
  soldPrice     Float?
  soldCurrency  Currency @default(USD)
  commissionUsd Float?
  closedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  lead Lead @relation("LeadOpportunities", fields: [leadId], references: [id], onDelete: Cascade)

  // One row per client × property so re-suggesting is impossible.
  @@unique([leadId, listingId])
  @@unique([leadId, counterpartLeadId])
  @@index([leadId])
  @@index([stage])
  @@index([viewingAt])
  @@map("lead_opportunities")
}
